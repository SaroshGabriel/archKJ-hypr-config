#
# ~/.bashrc — archmac
#

[[ $- != *i* ]] && return

# ── HOMELAB ENV (single source of truth) ─────────────────────
# Copy configs/homelab.env.example to ~/.config/homelab.env and fill in.
[ -f "$HOME/.config/homelab.env" ] && source "$HOME/.config/homelab.env"

# ── DEFAULTS ────────────────────────────────────────────────
alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='\[\e[1;35m\][\u@\h \W]\$ \[\e[0m\] '
export PATH="${PATH}:${HOME}/.local/bin"
export PATH="${HOME}/.npm-global/bin:${PATH}"

# ── GPG / PASS ───────────────────────────────────────────────
export GPG_TTY="${TTY:-$(tty 2>/dev/null)}"
export PASSWORD_STORE_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/pass"
gpg-connect-agent updatestartuptty /bye &>/dev/null

# Load a pass secret into an env var — usage: passenv VARNAME pass/path
passenv() {
    local var="${1}" path="${2}"
    export "${var}"="$(pass show "${path}" 2>/dev/null)" || echo "WARN: pass show ${path} failed" >&2
}

# ── SYSTEM ──────────────────────────────────────────────────
alias c='clear'
alias bye='systemctl poweroff'
alias restart='systemctl reboot'
alias ll='ls -la --color=auto'
alias la='ls -A --color=auto'
alias lss='ls -lSh --color=auto'
alias lst='ls -lt --color=auto'
alias mkdir='mkdir -p'
alias df='df -h'
alias du='du -sh'
alias free='free -h'
alias top='btop 2>/dev/null || htop 2>/dev/null || /usr/bin/top'
alias myip='ip addr show scope global | grep inet | awk "{print \$2}" | cut -d/ -f1'

# ── PACMAN ──────────────────────────────────────────────────
alias pacman='sudo pacman --noconfirm'
alias update='sudo pacman -Syu'
alias paci='sudo pacman -S --noconfirm'
alias pacr='sudo pacman -Rns'
alias pacs='pacman -Ss'
alias pacinfo='pacman -Qi'
alias pacfiles='pacman -Ql'
alias orphans='pacman -Qdtq'
alias cleanup='sudo pacman -Rns $(pacman -Qdtq) 2>/dev/null || echo "No orphans found"'

# ── PYTHON / DEV ────────────────────────────────────────────
alias py='python3'
alias ipy='ipython3'
alias jup='jupyter lab'
alias venv='source .venv/bin/activate'
alias venv-new='python3 -m venv .venv && source .venv/bin/activate'
alias pyreq='pip freeze > requirements.txt && echo "requirements.txt updated"'
alias pyinstall='pip install -r requirements.txt'
alias nifty='cd "${HOME}/LinuxScripts/niftyMonitor" && source .venv/bin/activate && python3 stock_monitor.py'

# ── NETWORK ─────────────────────────────────────────────────
alias ports='ls /dev/tty{USB,ACM}* 2>/dev/null || echo "No serial devices"'
alias netports='ss -tlnp'

# ── HYPRLAND ────────────────────────────────────────────────
alias snap='hyprshot -m output -o "${HOME}/Pictures/" -s'
alias snapr='hyprshot -m region -o "${HOME}/Pictures/" -s'
alias wb='killall waybar; sleep 2 && systemd-cat -t waybar waybar & disown'
alias reloadhypr='hyprctl reload'
alias shortcuts='grep "^bind" "${HOME}/.config/hypr/hyprland.conf"'
alias logind-reload='sudo systemctl kill -s HUP systemd-logind'

# ── SYSTEM LOGS ─────────────────────────────────────────────
alias journal='sudo journalctl -f'
alias jctl='sudo journalctl -xe'

# ── SNAPSHOT / BACKUP ───────────────────────────────────────
alias ts='smart-timeshift'
tsc() { smart-timeshift "archmac snapshot $(date +%Y-%m-%d)"; }

# ── REMOTE ──────────────────────────────────────────────────
# SSH host aliases resolve from your private ~/.ssh/config (not tracked here).
alias homelab='ssh ${HOMELAB_SSH_LAN:-homelab}'        # LAN host alias (from ~/.config/homelab.env)
alias homelab-ts='ssh ${HOMELAB_SSH_TS:-homelab-ts}'   # Tailscale host alias

# ── ALIASES ─────────────────────────────────────────────────
aliases() {
  local Y='\033[1;33m' G='\033[0;32m' N='\033[0m' D='\033[0;90m'
  local section='' pad=26
  while IFS= read -r line; do
    if [[ "$line" =~ ^#[[:space:]]──[[:space:]](.+) ]]; then
      section="${BASH_REMATCH[1]}"
      echo -e "\n${Y}── ${section}${N}"
    elif [[ "$line" =~ ^alias[[:space:]]([^=]+)=(.+) ]]; then
      local name="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]//\'/}"
      val="${val//\"/}"
      val="${val%%  #*}"
      [[ ${#val} -gt 52 ]] && val="${val:0:49}..."
      printf "  ${G}%-${pad}s${N} ${D}%s${N}\n" "$name" "$val"
    fi
  done < ~/.bashrc
  echo ''
}

# ── FZF ─────────────────────────────────────────────────────
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --preview "bat --color=always --line-range :50 {} 2>/dev/null || ls -la {}"'
source /usr/share/fzf/key-bindings.bash 2>/dev/null
source /usr/share/fzf/completion.bash 2>/dev/null

# ── STARTUP BANNER ───────────────────────────────────────────
# Branded fastfetch (window-aware Arch logo + system info).
# Interactive shells only (guarded at top of this file), once per shell.
if command -v fastfetch >/dev/null 2>&1 && [[ -z "$FASTFETCH_SHOWN" ]]; then
    export FASTFETCH_SHOWN=1
    "$HOME/.config/fastfetch/launch.sh"
fi
