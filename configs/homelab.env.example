# homelab.env — single source of truth for homelab references on this machine.
# Copy to ~/.config/homelab.env and fill in your own values. NOT tracked (git-ignored).
# ~/.bashrc sources it so nothing else hardcodes these.

HOMELAB_NAME="myhomelab · pi"
HOMELAB_LAN_IP="192.168.x.x"
HOMELAB_TS_IP="100.x.x.x"
HOMELAB_DOMAIN="example.com"
HOMELAB_SSH_USER="pi-user"
HOMELAB_SSH_LAN="pihost"          # ssh host alias (LAN) — define in ~/.ssh/config
HOMELAB_SSH_TS="pihost-ts"        # ssh host alias (Tailscale)
EXTRA_DISKS="/mnt/HDD1:/mnt/HDD2"   # colon-separated data-disk mountpoints to health-check
